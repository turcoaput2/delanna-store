# Delanna Lencería — Variables de entorno
# Copiá este archivo como .env y completá los valores

# Flask
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria
DATABASE_URL=sqlite:///delanna.db

# MercadoPago (obtener en https://www.mercadopago.com.ar/developers/panel/app)
MP_ACCESS_TOKEN=

# URL pública del sitio (sin / al final). Necesario para webhooks de MercadoPago.
# Ejemplos: https://delanna.onrender.com  o  https://delanna-store.up.railway.app
BASE_URL=

# Admin
ADMIN_URL_PREFIX=/atelier-privado-delanna
